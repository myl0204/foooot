# systemd unit — copy to /etc/systemd/system/oracle.service
# Assumes the app lives in /opt/oracle and runs as user "oracle".
[Unit]
Description=Oracle football predictions
After=network-online.target
Wants=network-online.target

[Service]
User=oracle
WorkingDirectory=/opt/oracle
EnvironmentFile=/opt/oracle/.env
Environment=NODE_ENV=production
Environment=PORT=8787
ExecStart=/usr/bin/env npx tsx server/src/index.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
