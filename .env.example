# AI-written match analysis (optional — without a key the app serves a
# clearly-labelled statistical summary). Set either key; if both are set,
# Anthropic is used unless ANALYSIS_PROVIDER=openai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# ANALYSIS_PROVIDER=openai

# Optional: real fixtures/results from football-data.org (free tier works).
# Without it the app runs on a deterministic demo league of fictional clubs.
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_COMPETITION=PL

PORT=8787
