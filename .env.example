# AI-written match analysis (optional — without a key the app serves a
# clearly-labelled statistical summary). Set either key; if both are set,
# Anthropic is used unless ANALYSIS_PROVIDER=openai. The same AI also
# translates club names into Chinese the dictionary doesn't cover.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# ANALYSIS_PROVIDER=openai

# Match data — API-Football (https://dashboard.api-football.com). Many leagues,
# several seasons each. Comma-separated league ids; the default is the top five
# leagues plus the Champions League, Championship, Eredivisie, Primeira Liga,
# Chinese Super League, J1 League and K League 1.
API_FOOTBALL_KEY=
# API_FOOTBALL_LEAGUES=39,140,135,78,61,2,40,88,94,169,98,292
# API_FOOTBALL_REFRESH_MINUTES=60   # how soon to re-fetch a season once a result is due
# HISTORY_SEASONS=2                 # previous seasons per league (model training data)

# Fallback when API_FOOTBALL_KEY is not set: football-data.org (free tier: 12
# competitions, current season + 3 before). Comma-separate several codes.
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_COMPETITION=PL

# With neither key the app runs on a deterministic demo league of fictional clubs.

PORT=8787
